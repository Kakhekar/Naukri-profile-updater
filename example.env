# ──────────────────────────────────────────────────────────────
# Naukri Auto-Updater — Example Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.
# ──────────────────────────────────────────────────────────────

# ── Naukri Session Cookies (required) ─────────────────────────
# Obtain these from your browser after logging into naukri.com:
# DevTools → Application → Cookies → https://www.naukri.com
NAUK_AT=your_nauk_at_cookie_value
NAUK_SID=your_nauk_sid_cookie_value
NAUK_RT=your_nauk_rt_cookie_value

# ── Browser ───────────────────────────────────────────────────
# Set to true for CI/headless environments; false to watch locally
HEADLESS=false

# ── Resume Upload ─────────────────────────────────────────────
# YOUR_NAME is used to build the date-stamped filename:
#   e.g. john_doe_28_05_2026.pdf
YOUR_NAME=your_name
RESUME_FILENAME=YourName.pdf

# ── Rotating Headlines (optional) ─────────────────────────────
# Separate each headline with ||
# If not set, a built-in 7-day rotation is used.
NAUKRI_HEADLINES=Software Engineer | Python | Django || Backend Engineer | Django | AWS || Full Stack Developer | React | Node.js || DevOps Engineer | CI/CD | Docker || Technical Lead | Agile | APIs || Product-focused Engineer | Data-Driven || Automation Specialist | Python | Playwright

# ── Rotating Profile Summary / About (optional) ───────────────
# Separate each blurb with ||
# If not set, a built-in 7-day rotation is used.
NAUKRI_ABOUT=Full Stack Developer with 2+ years of experience in React.js, Node.js, REST APIs, and CI/CD. Strong background in Agile, Docker, Kubernetes, and PostgreSQL.||Results-driven engineer with end-to-end ownership from design to production. React.js, Redux, Node.js, REST APIs, CI/CD, GitHub Copilot.
